# İlk MVP kural tabanlı analiz motoruyla environment variable olmadan çalışır.
# OpenRouter entegrasyonu opsiyoneldir; gerçek key yalnızca .env.local içinde tutulmalıdır.

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_DAILY_REQUEST_LIMIT=20
NEXT_PUBLIC_AI_ANALYSIS_NOTE_ENABLED=false

# Opsiyonel: fotoğraftan hasar kontrolü için görüntü anlayan OpenRouter modeli.
OPENROUTER_VISION_MODEL=openrouter/free
OPENROUTER_PHOTO_DAILY_REQUEST_LIMIT=10
NEXT_PUBLIC_AI_PHOTO_DAMAGE_ENABLED=false

# Opsiyonel: production/staging ortamında günlük AI limitini merkezi tutmak için.
# Boş bırakılırsa in-memory fallback kullanılır.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Opsiyonel: staging smoke kontrol scripti.
AI_STAGING_BASE_URL=https://eksperiq.vercel.app
AI_STAGING_LIVE=0

# Opsiyonel: bakım/ödeme hatırlatmaları için push bildirimi.
# `npm run push:generate-vapid-keys` ile üretilir. Boş bırakılırsa bildirim
# aboneliği devre dışı kalır (kullanıcıya "yapılandırılmadı" mesajı gösterilir).
# VAPID_PRIVATE_KEY yalnızca .env.local içinde tutulmalı, repoya yazılmamalıdır.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:destek@eksperiq.vercel.app
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Opsiyonel: /api/cron/check-reminders uç noktasını Vercel Cron dışından
# çağrılmaya karşı korumak için. Tanımlıysa istek Authorization: Bearer
# başlığıyla eşleşmelidir. Boş bırakılırsa kontrolsüz kalır (yalnızca yerel
# geliştirme için kabul edilebilir, production'da mutlaka ayarlanmalı).
CRON_SECRET=

# Opsiyonel: push aboneliklerinin ve hatırlatma verisinin kalıcı tutulması
# için. UPSTASH_REDIS_REST_URL/TOKEN ayarlanmazsa in-memory fallback
# kullanılır; bu, serverless (Vercel) ortamında istekler arasında kalıcı
# olmadığından cron bildirimlerinin gerçekten çalışması için bu iki
# değişkenin production'da ayarlanması ZORUNLUDUR.
