# Ilk MVP kural tabanli analiz motoruyla environment variable olmadan calisir.
# Gercek secret degerleri yalnizca .env.local ve hosting env icinde tutulmalidir.

OPENROUTER_API_KEY=
# "openrouter/free" rastgele bir ucretsiz modele yonlendirir; bunlar arasinda
# moderasyon/guvenlik modelleri de var ve anlamsiz cikti uretebiliyor. Bunun
# yerine guvenilir, isimli, gercekten ucretsiz (:free) bir sohbet modeli kullan.
OPENROUTER_MODEL=openai/gpt-oss-20b:free
OPENROUTER_DAILY_REQUEST_LIMIT=20
NEXT_PUBLIC_AI_ANALYSIS_NOTE_ENABLED=false

# Opsiyonel: fotograftan hasar kontrolu icin goruntu anlayan OpenRouter modeli.
# Gorsel girdiyi ve strict JSON semasini destekleyen, ucretsiz bir model.
OPENROUTER_VISION_MODEL=google/gemma-4-26b-a4b-it:free
OPENROUTER_PHOTO_DAILY_REQUEST_LIMIT=10
NEXT_PUBLIC_AI_PHOTO_DAMAGE_ENABLED=false

# Opsiyonel, yalnizca sunucu tarafinda okunur, hicbir zaman client'a acilmaz:
# admin'in kendi test ortaminda daha guclu/ucretli bir gorsel model denemesi
# icin. Gercek bir satin alma/entitlement dogrulamasi olmadigi surece bu
# degiskenler yalnizca admin'in kendi (uretim disi) deployment'inda
# ayarlanmali; production ortaminda bos birakilmalidir. Bu, gercek kullanici
# bazli Pro/Pro+ segmentasyonu DEGILDIR — yalnizca admin'in iki farkli
# model kalitesini kendi test ortaminda karsilastirmasi icindir.
EKSPERIQ_FORCE_PRO=false
OPENROUTER_VISION_MODEL_PRO=
EKSPERIQ_FORCE_PRO_PLUS=false
OPENROUTER_VISION_MODEL_PRO_PLUS=

# ZORUNLU (production'da): gunluk AI limiti, push kayitlari ve AI rate limit
# icin kalici depolama. Vercel Upstash entegrasyonu su isimleri otomatik
# uretebilir: UPSTASH_REDIS_REST_KV_REST_API_URL / _KV_REST_API_TOKEN.
# Bu iki degisken (veya KV_ karsiliklari) + RATE_LIMIT_HASH_SECRET
# tanimli degilse AI endpointleri fail-closed davranir (503 doner, limitsiz
# gecmez).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ZORUNLU (production'da): AI rate limit icin IP/kurulum kimligini hashlemekte
# kullanilan sunucu-only sir. Asla client'a gonderilmez, asla commit edilmez.
# Rastgele, uzun bir deger uret (orn. `openssl rand -hex 32`).
RATE_LIMIT_HASH_SECRET=

# Opsiyonel: AI rate limit katmanlarinin ayarlari (makul varsayilanlar var).
AI_BURST_LIMIT=5
AI_BURST_WINDOW_SECONDS=60
AI_PHOTO_DAILY_LIMIT_PER_INSTALL=4
AI_NOTE_DAILY_LIMIT_PER_INSTALL=8

# Opsiyonel: OpenRouter isteklerine provider.zdr=true (zero data retention)
# filtresi ekler. Varsayilan olarak KAPALI — bu, kullanilan ucretsiz
# modeller icin hicbir uygun provider birakmayip route'lamayi
# basarisiz kilabilir; bu ortamda gercek OpenRouter API'sine karsi
# dogrulanamadi. Acmadan once Preview ortaminda deneyip AI
# endpointlerinin hala 200 dondugunu teyit edin.
OPENROUTER_REQUIRE_ZDR=false

# Opsiyonel: bakim/odeme hatirlatmalari icin web push bildirimi.
# npm run push:generate-vapid-keys ile uretilir.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:destek@eksperiq.vercel.app
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Opsiyonel: /api/cron/check-reminders endpoint'ini dis cagrilara karsi korumak icin.
CRON_SECRET=

# Opsiyonel: staging smoke kontrol scripti.
AI_STAGING_BASE_URL=https://eksperiq.vercel.app
AI_STAGING_LIVE=0

# StoreKit 2 / App Store Server Notifications V2 (bkz. docs/ios-storekit-integration.md).
# Ikisi de fail-closed: bu bayraklardan biri tanimli/true degilse ilgili
# /api/iap/* endpoint'i her istegi 503 ile reddeder. Gercek bir App Store
# Connect abonelik urunu ve webhook kaydi olusana kadar production'da BOS/
# false birakilmalidir.
APPLE_APP_STORE_NOTIFICATIONS_ENABLED=false
APPLE_IAP_ENTITLEMENT_ENABLED=false

# ZORUNLU (APPLE_IAP_ENTITLEMENT_ENABLED=true oldugunda): istemciye donen
# kisa omurlu entitlement token'ini imzalamak icin sunucu-only sir. Asla
# client'a gonderilmez, asla commit edilmez. Rastgele, uzun bir deger uret
# (orn. `openssl rand -hex 32`).
STOREKIT_ENTITLEMENT_TOKEN_SECRET=
