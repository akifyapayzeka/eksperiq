{
  "name": "eksperiq",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "screenshots": "playwright test tests/e2e/screenshots.spec.ts",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "native:build": "npm run build && npx cap sync",
    "ios:add": "npx cap add ios",
    "ios:sync": "npm run build && npx cap sync ios",
    "ios:open": "npx cap open ios",
    "ai:env-check": "node scripts/check-ai-env.mjs",
    "ai:staging-check": "node scripts/check-ai-staging.mjs",
    "ai:live-check": "node scripts/check-ai-live-once.mjs",
    "appstore:package": "node scripts/prepare-app-store-package.mjs",
    "appstore:screenshots": "node scripts/generate-app-store-screenshots.mjs",
    "appstore:check": "node scripts/check-app-store-package.mjs",
    "appstore:prepare": "npm run appstore:package && npm run appstore:screenshots && npm run appstore:check",
    "hostinger:package": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-hostinger.ps1"
  },
  "dependencies": {
    "@capacitor/core": "^8.4.2",
    "@capacitor/ios": "^8.4.2",
    "@hookform/resolvers": "^5.5.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.27.0",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.83.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.4",
    "@capacitor/cli": "^8.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
